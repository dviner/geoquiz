# Production (Vercel, or any deploy that can't use a local file): point at a real Turso database.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Local development: leave the above unset and this is used instead (plain SQLite file, no
# external account needed).
DATABASE_PATH=./data/geoquiz.db
